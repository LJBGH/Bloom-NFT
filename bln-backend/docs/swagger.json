    "definitions": {
        "model.WalletAccount": {
            "type": "object",
            "properties": {
                "address": {
                    "type": "string"
                },
                "index": {
                    "type": "integer"
                },
                "mnemonic": {
                    "description": "仅用于接口返回（wallet.json 的 accounts 节点不会写入）",
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "path": {
                    "type": "string"
                },
                "privateKey": {
                    "type": "string"
                },
                "publicKey": {
                    "type": "string"
                }
            }
        },
        "request.BidPlacedRequest": {
            "type": "object",
            "required": [
                "buyer",
                "deadline",
                "nonce",
                "ordersId",
                "price",
                "signature"
            ],
            "properties": {
                "buyer": {
                    "type": "string"
                },
                "deadline": {
                    "type": "string"
                },
                "nonce": {
                    "type": "integer",
                    "minimum": 0
                },
                "ordersId": {
                    "type": "integer"
                },
                "price": {
                    "type": "number"
                },
                "signature": {
                    "description": "EIP-712 signature",
                    "type": "string"
                }
            }
        },
        "request.EntryOrdersRequest": {
            "type": "object",
            "required": [
                "deadline",
                "nftListId",
                "nonce",
                "salt",
                "price",
                "seller",
                "signature",
                "tokenId"
            ],
            "properties": {
                "deadline": {
                    "description": "截止时间",
                    "type": "string"
                },
                "nftListId": {
                    "description": "NFTId",
                    "type": "integer"
                },
                "nonce": {
                    "description": "非重复 nonce（允许 0）",
                    "type": "integer",
                    "minimum": 0
                },
                "salt": {
                    "description": "Listing EIP-712 salt（十进制字符串，uint256）",
                    "type": "string"
                },
                "price": {
                    "description": "Price 价格（BT）",
                    "type": "number"
                },
                "seller": {
                    "description": "卖家地址",
                    "type": "string"
                },
                "signature": {
                    "description": "EIP-712 signature",
                    "type": "string"
                },
                "tokenId": {
                    "description": "tokenId",
                    "type": "integer"
                }
            }
        },
        "request.LoginRequest": {
            "type": "object",
            "required": [
                "password",
                "username"
            ],
            "properties": {
                "password": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
        },
        "response.WalletAccountResult": {
            "type": "object",
            "properties": {
                "address": {
                    "type": "string"
                },
                "index": {
                    "type": "integer"
                },
                "mnemonic": {
                    "description": "仅用于接口返回（wallet.json 的 accounts 节点不会写入）",
                    "type": "string"
                },
                "name": {
                    "type": "string"
